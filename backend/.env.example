# === Advitiyans Backend — Environment Configuration ===

# --- Database (Local Development) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=advitiyans
DB_SSL=false

# --- AWS Deployment (set automatically by CDK) ---
# DB_HOST=<rds-proxy-endpoint>.proxy-xxxx.ap-south-1.rds.amazonaws.com
# DB_PORT=5432
# DB_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789:secret:advitiyans-db-credentials-xxxxx
# DB_SSL=true

# --- Feature Flags ---
# Set USE_MOCK=true to run without a database (in-memory demo mode)
USE_MOCK=false

# --- Security: Admin & HOD Credentials (REQUIRED — no defaults, fails closed if unset) ---
# ADMIN_MASTER_EMAIL=admin@rgmcet.edu.in
# ADMIN_MASTER_PASS=<strong-admin-password>
# HOD_MASTER_EMAIL=hodcseds@rgmcet.edu.in
# HOD_MASTER_PASS=<strong-hod-password>

# --- Security: Faculty Registration Key (REQUIRED — no default, fails closed if unset) ---
# FACULTY_SECRET_KEY=<your-secret-registration-key>

# --- Security: DB Init/Migrate endpoint protection ---
# ADMIN_SECRET=<random-secret-for-db-init-header>

# --- GitHub Integration (5,000 req/hr rate limit) ---
# GITHUB_PAT=ghp_your_github_token_here

