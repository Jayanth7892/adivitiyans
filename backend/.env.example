# === Advitiyans Backend — Environment Configuration ===

# --- Database (Local Development) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=advitiyans
DB_SSL=false

# --- AWS Deployment (set automatically by CDK) ---
# DB_HOST=<rds-proxy-endpoint>.proxy-xxxx.ap-south-1.rds.amazonaws.com
# DB_PORT=5432
# DB_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789:secret:advitiyans-db-credentials-xxxxx
# DB_SSL=true

# --- Feature Flags ---
# Set USE_MOCK=true to run without a database (in-memory demo mode)
USE_MOCK=false
