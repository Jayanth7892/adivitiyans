{
  "name": "advitiyans-backend",
  "version": "1.0.0",
  "description": "Advitiyans Student 360 & Placement Readiness Platform API",
  "main": "dist/handlers/api.js",
  "scripts": {
    "build": "tsc && esbuild src/handlers/api.ts --bundle --platform=node --target=node20 --outfile=dist/handlers/api.js --external:pg-native && esbuild src/handlers/cognito-pre-signup.ts --bundle --platform=node --target=node20 --outfile=dist/handlers/cognito-pre-signup.js",
    "test": "echo \"Error: no test specified\" && exit 0",
    "start": "ts-node src/local.ts",
    "db:init": "ts-node src/scripts/init-db.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1110.0",
    "@aws-sdk/client-dynamodb": "^3.1111.0",
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/client-secrets-manager": "^3.1103.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "pg": "^8.11.3",
    "serverless-http": "^3.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.136",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.2",
    "esbuild": "^0.28.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
